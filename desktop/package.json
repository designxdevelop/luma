{
  "name": "luma-windows",
  "productName": "Luma",
  "version": "0.2.0",
  "description": "Luma for Windows and Linux: a controller for Govee lights. Luma is an open-source project built by Design X Develop LLC.",
  "author": "Design X Develop LLC",
  "license": "MIT",
  "homepage": "https://github.com/designxdevelop/luma",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "runtime:install": "node node_modules/electron/install.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "demo": "npm run build && electron . --demo",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "icons": "node scripts/make-icons.mjs",
    "dist:linux": "npm run build && electron-builder --config electron-builder.linux.cjs --linux tar.gz --x64 --arm64"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.designxdevelop.luma",
    "productName": "Luma",
    "copyright": "Copyright (c) 2026 Design X Develop LLC",
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
